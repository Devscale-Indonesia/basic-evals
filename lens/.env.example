# Local Lens stack. Replace every secret below before starting Docker Compose.
# Use the same origin as WEB_ORIGIN for PUBLIC_APP_URL.
PUBLIC_APP_URL=http://localhost
WEB_ORIGIN=http://localhost
# Change both URLs above to include the port if you change WEB_PORT.
WEB_PORT=80

# Generate a separate value for each secret, for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-secret
CLICKHOUSE_PASSWORD=replace-with-a-random-secret
REDIS_PASSWORD=replace-with-a-random-secret
BETTER_AUTH_SECRET=replace-with-a-random-secret
INGESTION_KEY_PEPPER=replace-with-a-random-secret
